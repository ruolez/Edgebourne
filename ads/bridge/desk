#!/usr/bin/env python3
"""desk: Claude's line to the Ads console Desk (ads.edgebourne.com).

Reads the dashboard address from ~/.config/ads-desk/config.json and the Mac key
from the macOS Keychain, so the key never appears in a prompt, a file or a
command line. Installed to ~/.claude/skills/ads-desk/desk by install.sh.

A run the bridge starts gets its request's pass in DESK_CLAIM and sends it with every
call: the dashboard then answers only for that request and its account. `desk claim`
by hand keeps the pass in ~/.config/ads-desk/claims.json for the later calls.

  desk task <id>                         the task, with earlier reports/proposals
  desk claim                             take the next queued task (prints it), or "none"
  desk queue                             queued and active tasks
  desk snapshot [7|14|30]                performance + lead quality from the dashboard
  desk history                           recent finished tasks (summaries, report titles)
  desk log-applied <id>                  append applied budget / on-off / spending-limit suggestions to reports/log.md
  desk outcomes [--days 60]              did it work: before/after results of changes and suggestions, declined ones
  desk progress <id> <text>              status line shown live on the Desk page
  desk report <id> --title T [--file F]  report body from F or stdin (Markdown)
  desk propose <id> [--file F]           proposals JSON from F or stdin
  desk scorecard <id> [--file F]         polish results JSON from F or stdin
  desk upload <path>                     image/video into the ad account's media library (prints hash / video_id)
  desk attach <id> <path> [--caption T]  show a preview (JPG/PNG/WebP up to 10 MB, MP4 up to 60 MB, from this request's
                                         own folder creatives/<date>-desk-<id>/) in its answer on the Claude page (prints {"id": …})
  desk probe <video>                     duration, size, streams of a video in the workspace (JSON)
  desk frames <video> --task ID [--every S]
                                         frames every S seconds (default 1) + a contact sheet, into
                                         reports/desk/tmp/task<ID>-frames/ (prints the folder)
  desk watched                           competitor Pages to check, and Ad Library ids already saved
  desk swipe [--task ID] [--file F]      save competitor ads (JSON list) into the swipe file; --task shows them in that answer
  desk benchmarks [--file F]             the week's benchmarks for Today (JSON: as_of, summary, items)
  desk done <id> --summary S             finish
  desk fail <id> --error E               give up, with the reason
"""
import argparse
import datetime
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import urllib.error
import urllib.request

VERSION = "3.0"
# ADS_DESK_CONFIG points a test run at another dashboard (e.g. the local dev stack).
CONFIG = os.environ.get("ADS_DESK_CONFIG") or os.path.expanduser("~/.config/ads-desk/config.json")
SERVICE = "ads-desk"
CLAIMS = os.path.join(os.path.dirname(CONFIG), "claims.json")


def config():
    try:
        with open(CONFIG) as fh:
            return json.load(fh)
    except FileNotFoundError:
        sys.exit("ads-desk is not set up on this Mac. Run: bash ~/Desktop/Dev/edgebourne/ads/bridge/install.sh")


def key(cfg):
    try:
        out = subprocess.run(["security", "find-generic-password", "-s", SERVICE, "-a", cfg["base_url"], "-w"],
                             capture_output=True, text=True, check=True)
    except subprocess.CalledProcessError:
        sys.exit("No Mac key in the Keychain. Create one on the Desk page and run install.sh again.")
    return out.stdout.strip()


def saved_claims():
    try:
        with open(CLAIMS) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def save_claim(task_id, claim):
    """`desk claim` by hand: keep the pass for this request's later calls (newest 20)."""
    claims = {**saved_claims(), str(task_id): claim}
    claims = dict(list(claims.items())[-20:])
    fd = os.open(CLAIMS, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        json.dump(claims, fh)


def claim_for(path):
    """The pass this call carries: the run's own (DESK_CLAIM), else one saved by `desk claim`."""
    if os.environ.get("DESK_CLAIM"):
        return os.environ["DESK_CLAIM"]
    m = re.match(r"^/api/agent/tasks/(\d+)", path)
    return saved_claims().get(m.group(1)) if m else None


def headers(token, claim):
    h = {"Authorization": f"Bearer {token}",
         "X-Bridge-Host": socket.gethostname().split(".")[0],
         "X-Bridge-Version": VERSION,
         # Agency mode: the bridge runs each task with DESK_ACCOUNT set to the task's account.
         "X-Account": os.environ.get("DESK_ACCOUNT", "1"),
         "User-Agent": f"ads-desk/{VERSION}"}
    if claim:
        h["X-Desk-Claim"] = claim
    return h


class DeskError(Exception):
    def __init__(self, status, message):
        super().__init__(message)
        self.status = status


def call(method, path, body=None, timeout=40, cfg=None, token=None, claim=None):
    cfg = cfg or config()
    token = token or key(cfg)
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(cfg["base_url"].rstrip("/") + path, data=data, method=method,
                                 headers={**headers(token, claim or claim_for(path)), "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as res:
            raw = res.read()
            return res.status, (json.loads(raw) if raw else None)
    except urllib.error.HTTPError as exc:
        try:
            msg = json.loads(exc.read()).get("error")
        except Exception:
            msg = None
        raise DeskError(exc.code, msg or f"HTTP {exc.code}") from None


def upload(cfg, token, path):
    """Multipart POST of one file to /api/agent/media/upload."""
    import mimetypes
    ctype = mimetypes.guess_type(path)[0] or "application/octet-stream"
    if path.lower().endswith(".mov"):
        ctype = "video/quicktime"
    return post_file(cfg, token, "/api/agent/media/upload", path, ctype)


def post_file(cfg, token, api_path, path, ctype, fields=None):
    """Multipart POST of one file (plus text fields) with the run's pass."""
    import uuid
    boundary = uuid.uuid4().hex
    with open(path, "rb") as fh:
        data = fh.read()
    parts = b"".join(f"--{boundary}\r\nContent-Disposition: form-data; name=\"{k}\"\r\n\r\n{v}\r\n".encode()
                     for k, v in (fields or {}).items() if v is not None)
    head = (f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"{os.path.basename(path)}\"\r\n"
            f"Content-Type: {ctype}\r\n\r\n").encode()
    body = parts + head + data + f"\r\n--{boundary}--\r\n".encode()
    req = urllib.request.Request(cfg["base_url"].rstrip("/") + api_path, data=body, method="POST",
                                 headers={**headers(token, claim_for(api_path)), "Content-Type": f"multipart/form-data; boundary={boundary}"})
    try:
        with urllib.request.urlopen(req, timeout=900) as res:
            return json.loads(res.read())
    except urllib.error.HTTPError as exc:
        try:
            msg = json.loads(exc.read()).get("error")
        except Exception:
            msg = None
        raise DeskError(exc.code, msg or f"HTTP {exc.code}") from None


VIDEO_FORMATS = {".mp4": "mov", ".mov": "mov", ".m4v": "mov", ".webm": "matroska", ".mkv": "matroska"}


def media_input(workdir, path):
    """The real path and container of a video inside the workspace, or ValueError. Runs get `desk frames`
    and `desk probe` instead of ffmpeg itself, which would open any path on the Mac (audit A3-4)."""
    root = os.path.realpath(workdir or "")
    real = os.path.realpath(path)
    fmt = VIDEO_FORMATS.get(os.path.splitext(real)[1].lower())
    if not workdir or os.path.commonpath([root, real]) != root or real == root:
        raise ValueError(f"{path} isn't inside the workspace ({root})")
    if not fmt or not os.path.isfile(real):
        raise ValueError(f"{path} isn't a video file ({', '.join(sorted(VIDEO_FORMATS))})")
    return real, fmt


ATTACH_TYPES = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".webp": "image/webp", ".mp4": "video/mp4"}
ATTACH_MAX = {"image": 10 * 1024 * 1024, "video": 60 * 1024 * 1024}


def own_folder(rel, task_id):
    """True when a workspace-relative path (its parts) sits in request <task_id>'s own folders: the render folder the
    skill names (`creatives/<date>-desk-<id>/`, older runs `-desk-task<id>/`) or its frames (`reports/desk/tmp/task<id>-…/`)."""
    if len(rel) >= 3 and rel[0] == "creatives" and re.search(rf"-desk-(task)?{int(task_id)}$", rel[1]):
        return True
    return len(rel) >= 5 and rel[:3] == ["reports", "desk", "tmp"] and rel[3].startswith(f"task{int(task_id)}-")


def attach_input(workdir, path, task_id):
    """The real path and type of a preview request <task_id> made itself, or ValueError (FU-D `desk attach`). The
    workspace is shared by every business, so a run shows only its own renders, never another client's creatives
    (security review). The console checks the bytes again."""
    root = os.path.realpath(workdir or "")
    real = os.path.realpath(path)
    ctype = ATTACH_TYPES.get(os.path.splitext(real)[1].lower())
    if not workdir or os.path.commonpath([root, real]) != root or real == root:
        raise ValueError(f"{path} isn't inside the workspace ({root})")
    if not own_folder(os.path.relpath(real, root).split(os.sep), task_id):
        raise ValueError(f"{path} isn't in this request's own folder: render into creatives/<today>-desk-{int(task_id)}/ and attach from there")
    if not ctype or not os.path.isfile(real):
        raise ValueError(f"{path} isn't a preview file (JPG, PNG, WebP or MP4)")
    kind = ctype.split("/")[0]
    if os.path.getsize(real) > ATTACH_MAX[kind]:
        raise ValueError(f"{path} is too big for a preview ({'images up to 10 MB' if kind == 'image' else 'videos up to 60 MB'})")
    return real, ctype


def media_head(tool, real, fmt):
    # Local files only, in the container the name says (no playlists, no network, no references).
    return [tool, "-hide_banner", "-v", "error", "-protocol_whitelist", "file", "-f", fmt, "-i", real]


def probe_args(real, fmt):
    return media_head("ffprobe", real, fmt) + [
        "-show_entries", "format=duration,size,bit_rate:stream=codec_type,codec_name,width,height,r_frame_rate,sample_rate,channels",
        "-of", "json"]


def frames_args(real, fmt, out_dir, every):
    rate = f"fps=1/{every:g}"
    return [media_head("ffmpeg", real, fmt) + ["-y", "-vf", f"{rate},scale=540:-2", "-frames:v", "60",
                                               os.path.join(out_dir, "frame-%03d.jpg")],
            media_head("ffmpeg", real, fmt) + ["-y", "-vf", f"{rate},scale=216:-2,tile=6x6", "-frames:v", "1",
                                               os.path.join(out_dir, "sheet.jpg")]]


def run_media(cmd):
    tool = shutil.which(cmd[0], path=os.pathsep.join([os.environ.get("PATH", ""), "/opt/homebrew/bin", "/usr/local/bin"]))
    if not tool:
        sys.exit(f"{cmd[0]} isn't installed on this Mac (brew install ffmpeg)")
    out = subprocess.run([tool] + cmd[1:], capture_output=True, text=True)
    if out.returncode != 0:
        sys.exit(f"{cmd[0]} failed: {out.stderr.strip()[-400:]}")
    return out.stdout


def read_body(path, workdir):
    """--file F (or stdin). `desk` runs outside Claude Code's sandbox in a full run, so F must be a file in the
    workspace by its real path, and never a .env: a run can't post ~/.ssh or the Meta token into a report."""
    if not path:
        return sys.stdin.read()
    root = os.path.realpath(workdir or "")
    real = os.path.realpath(path)
    if not workdir or os.path.commonpath([root, real]) != root or real == root:
        raise ValueError(f"{path} isn't inside the workspace ({root}): write it under reports/desk/tmp/")
    if os.path.basename(real).startswith(".env"):
        raise ValueError(f"{path} can't be sent")
    with open(real) as fh:
        return fh.read()


def save_local_copy(cfg, task_id, title, body):
    folder = os.path.join(cfg.get("workdir", "."), "reports", "desk")
    try:
        os.makedirs(folder, exist_ok=True)
        name = f"{datetime.date.today().isoformat()}-task{task_id}.md"
        with open(os.path.join(folder, name), "a") as fh:
            fh.write(f"# {title}\n\n{body.strip()}\n\n")
        return os.path.join(folder, name)
    except OSError:
        return None


LOGGED_KINDS = {"budget": "budget", "status": "on/off", "spend_limit": "spending limit"}


def applied_log_lines(history, existing):
    """reports/log.md lines for applied budget, on/off and spending-limit suggestions in `desk history` that the log
    doesn't name yet ("[desk #<id>]"). Fixed format, one line each, words flattened, so nothing a run reads can
    become more than a value in the log."""
    def flat(value):
        text = re.sub(r"\s+", " ", str(value if value is not None else "")).replace("[", "(").replace("]", ")").strip()
        return text[:80] or "—"
    out = []
    for task in history or []:
        for p in task.get("proposals") or []:
            if p.get("status") != "applied" or p.get("kind") not in LOGGED_KINDS or f"[desk #{p.get('id')}]" in (existing or ""):
                continue
            day = str(p.get("decided_at") or "")[:10] or "—"
            out.append(f"- {day} [desk #{int(p['id'])}] {LOGGED_KINDS[p['kind']]}: {flat(p.get('entity_name') or p.get('title'))}: "
                       f"{flat(p.get('current_value'))} → {flat(p.get('proposed_value'))} (by Accept on the Claude page)")
    return out


def log_applied(cfg, go, task_id):
    """Only for the owner's own requests: another business's or a teammate's run never writes the owner's log."""
    task = go("GET", f"/api/agent/tasks/{task_id}")[1]
    if task.get("account_id") not in (None, 1) or task.get("from_owner") is not True:
        return "skipped: this request isn't the owner's own, so the change log stays as it is"
    path = os.path.join(os.path.realpath(cfg["workdir"]), "reports", "log.md")
    try:
        with open(path, encoding="utf-8") as fh:
            existing = fh.read()
    except FileNotFoundError:
        existing = ""
    lines = applied_log_lines(go("GET", "/api/agent/history")[1], existing)
    if lines:
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(("" if not existing or existing.endswith("\n") else "\n") + "\n".join(lines) + "\n")
    return f"{len(lines)} line{'' if len(lines) == 1 else 's'} added to reports/log.md"


def main(argv=None):
    p = argparse.ArgumentParser(prog="desk", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("task").add_argument("id", type=int)
    sub.add_parser("claim")
    sub.add_parser("queue")
    sp = sub.add_parser("snapshot"); sp.add_argument("range", nargs="?", default="7", choices=["7", "14", "30"])
    sub.add_parser("history")
    sub.add_parser("log-applied").add_argument("id", type=int)
    sp = sub.add_parser("outcomes"); sp.add_argument("--days", type=int, default=60)
    sp = sub.add_parser("progress"); sp.add_argument("id", type=int); sp.add_argument("text", nargs="+")
    sp = sub.add_parser("report"); sp.add_argument("id", type=int); sp.add_argument("--title", required=True); sp.add_argument("--file")
    sp = sub.add_parser("propose"); sp.add_argument("id", type=int); sp.add_argument("--file")
    sp = sub.add_parser("scorecard"); sp.add_argument("id", type=int); sp.add_argument("--file")
    sp = sub.add_parser("upload"); sp.add_argument("path")
    sp = sub.add_parser("attach"); sp.add_argument("id", type=int); sp.add_argument("path"); sp.add_argument("--caption")
    sp = sub.add_parser("probe"); sp.add_argument("path")
    sp = sub.add_parser("frames"); sp.add_argument("path"); sp.add_argument("--task", type=int, required=True)
    sp.add_argument("--every", type=float, default=1.0)
    sub.add_parser("watched")
    sp = sub.add_parser("swipe"); sp.add_argument("--task", type=int); sp.add_argument("--file")
    sp = sub.add_parser("benchmarks"); sp.add_argument("--file")
    sp = sub.add_parser("done"); sp.add_argument("id", type=int); sp.add_argument("--summary", required=True)
    sp = sub.add_parser("fail"); sp.add_argument("id", type=int); sp.add_argument("--error", required=True)
    a = p.parse_args(argv)
    cfg = config()
    if a.cmd == "attach":
        try:
            real, ctype = attach_input(cfg.get("workdir"), a.path, a.id)
        except ValueError as exc:
            sys.exit(str(exc))
        try:
            print(json.dumps(post_file(cfg, key(cfg), f"/api/agent/tasks/{a.id}/attachments", real, ctype,
                                       {"caption": (a.caption or "").strip()[:300] or None})))
        except DeskError as exc:
            sys.exit(f"Desk said no ({exc.status}): {exc}")
        except (urllib.error.URLError, OSError) as exc:
            sys.exit(f"Can't reach the dashboard: {exc}")
        return
    if a.cmd in ("probe", "frames"):
        try:
            real, fmt = media_input(cfg.get("workdir"), a.path)
        except ValueError as exc:
            sys.exit(str(exc))
        if a.cmd == "probe":
            print(run_media(probe_args(real, fmt)).strip())
            return
        out_dir = os.path.join(os.path.realpath(cfg["workdir"]), "reports", "desk", "tmp", f"task{a.task}-frames")
        os.makedirs(out_dir, exist_ok=True)
        for cmd in frames_args(real, fmt, out_dir, min(10.0, max(0.1, a.every))):
            run_media(cmd)
        print(out_dir)
        return
    token = key(cfg)

    def go(method, path, body=None):
        return call(method, path, body, cfg=cfg, token=token)

    try:
        if a.cmd == "task":
            print(json.dumps(go("GET", f"/api/agent/tasks/{a.id}")[1], indent=2, default=str))
        elif a.cmd == "claim":
            status, task = go("GET", "/api/agent/wait?timeout=0")
            if status == 200 and task.get("claim_token"):
                save_claim(task["id"], task["claim_token"])
            if status == 200:
                task.pop("claim_token", None)
            print(json.dumps(task, indent=2) if status == 200 else "none")
        elif a.cmd == "queue":
            print(json.dumps(go("GET", "/api/agent/queue")[1], indent=2))
        elif a.cmd == "snapshot":
            print(json.dumps(go("GET", f"/api/agent/snapshot?range={a.range}")[1], indent=2))
        elif a.cmd == "history":
            print(json.dumps(go("GET", "/api/agent/history")[1], indent=2))
        elif a.cmd == "log-applied":
            print(log_applied(cfg, go, a.id))
        elif a.cmd == "outcomes":
            print(json.dumps(go("GET", f"/api/agent/outcomes?days={max(1, min(60, a.days))}")[1], indent=2))
        elif a.cmd == "progress":
            go("POST", f"/api/agent/tasks/{a.id}/status", {"status": "running", "progress": " ".join(a.text)})
            print("ok")
        elif a.cmd == "report":
            body = read_body(a.file, cfg.get("workdir"))
            go("POST", f"/api/agent/tasks/{a.id}/report", {"title": a.title, "body": body})
            local = save_local_copy(cfg, a.id, a.title, body)
            print("report posted" + (f" (copy: {local})" if local else ""))
        elif a.cmd == "propose":
            raw = json.loads(read_body(a.file, cfg.get("workdir")))
            items = raw["proposals"] if isinstance(raw, dict) else raw
            print(json.dumps(go("POST", f"/api/agent/tasks/{a.id}/proposals", {"proposals": items})[1]))
        elif a.cmd == "scorecard":
            raw = json.loads(read_body(a.file, cfg.get("workdir")))
            body = raw if isinstance(raw, dict) else {"passes": raw}
            print(json.dumps(go("POST", f"/api/agent/tasks/{a.id}/scorecard", body)[1]))
        elif a.cmd == "upload":
            root, real = os.path.realpath(cfg.get("workdir") or ""), os.path.realpath(a.path)
            if not cfg.get("workdir") or os.path.commonpath([root, real]) != root or os.path.basename(real).startswith(".env"):
                sys.exit(f"{a.path} isn't inside the workspace ({root}): render under creatives/ and upload from there")
            if not os.path.isfile(real):
                sys.exit(f"No file at {a.path}")
            print(json.dumps(upload(cfg, token, real)))
        elif a.cmd == "watched":
            print(json.dumps(go("GET", "/api/agent/watched")[1], indent=2))
        elif a.cmd == "swipe":
            raw = json.loads(read_body(a.file, cfg.get("workdir")))
            items = raw["swipes"] if isinstance(raw, dict) else raw
            print(json.dumps(go("POST", "/api/agent/swipes", {"swipes": items, "task_id": a.task})[1]))
        elif a.cmd == "benchmarks":
            raw = json.loads(read_body(a.file, cfg.get("workdir")))
            body = raw if isinstance(raw, dict) else {"items": raw}
            print(json.dumps(go("POST", "/api/agent/benchmarks", body)[1]))
        elif a.cmd == "done":
            go("POST", f"/api/agent/tasks/{a.id}/status", {"status": "done", "summary": a.summary})
            print("done")
        elif a.cmd == "fail":
            go("POST", f"/api/agent/tasks/{a.id}/status", {"status": "failed", "error": a.error})
            print("marked failed")
    except DeskError as exc:
        sys.exit(f"Desk said no ({exc.status}): {exc}")
    except ValueError as exc:  # a --file outside the workspace (read_body); JSON errors are ValueErrors too
        sys.exit(str(exc))
    except (urllib.error.URLError, OSError) as exc:
        sys.exit(f"Can't reach the dashboard: {exc}")


if __name__ == "__main__":
    main()
