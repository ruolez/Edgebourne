# Copy to .env and set real values before `docker compose up`
SECRET_KEY=change-me-long-random-string
POSTGRES_PASSWORD=change-me
ADMIN_INITIAL_PASSWORD=change-me
APP_PORT=8090

# SECRET_KEY above also encrypts the Stripe and SMTP secrets stored in the
# database. Changing it makes those unreadable and they must be re-entered.

# Everything below is OPTIONAL. Billing keys and the public address are normally
# configured in the admin panel (Billing settings) and stored encrypted. Setting
# them here takes precedence and shows them as locked in the UI -- use that only
# if you would rather keep keys off the database entirely.
PUBLIC_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_PREVIOUS=

# Recurring-invoice scheduler (runs as its own container).
SCHEDULER_ENABLED=1
SCHEDULER_TICK_SECONDS=60
