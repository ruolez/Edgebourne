# Copy to .env and set real values before `docker compose up`
SECRET_KEY=change-me-long-random-string
POSTGRES_PASSWORD=change-me
ADMIN_INITIAL_PASSWORD=change-me
APP_PORT=8090

# Absolute public origin. Required by the billing module: emailed pay links and
# Stripe redirect URLs are built here, and the mailer/scheduler have no request
# to derive it from. Must be https:// in production -- Stripe rejects http://.
PUBLIC_BASE_URL=http://localhost:8090

# Stripe. Mode (test vs live) is derived from the secret key prefix -- there is
# no separate toggle to fall out of sync. Leave blank to disable card payments;
# the rest of the billing module works without them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: set during a webhook-secret rotation so both are accepted.
STRIPE_WEBHOOK_SECRET_PREVIOUS=

# Recurring-invoice scheduler (runs as its own container).
SCHEDULER_ENABLED=1
SCHEDULER_TICK_SECONDS=60
